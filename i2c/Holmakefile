INCLUDES = ../common $(CAKEMLDIR)/semantics/ffi $(HARDWAREDIR)/verilog $(HARDWAREDIR)/translator

all: $(DEFAULT_TARGETS)
.PHONY: all

REGISTER_INTERFACE = $(shell bender -d $(CHESHIREDIR) path register_interface)
COMMON_CELLS = $(shell bender -d $(CHESHIREDIR) path common_cells)
OPENTITAN_PERIPHERALS = $(shell bender -d $(CHESHIREDIR) path opentitan_peripherals)

CHESHIRE_INCDIRS = $(shell bender -d $(CHESHIREDIR) script template_json | jq -r .all_incdirs.[])
CHESHIRE_INC = $(patsubst %, -I%, $(CHESHIRE_INCDIRS))

i2cRegsScript.sml: ../util/gen_regs.py ../util/common.py
	PYTHONPATH="$(REGISTER_INTERFACE)/vendor/lowrisc_opentitan/util:..:$PYTHONPATH" \
		python3 -m util.gen_regs \
		"$(OPENTITAN_PERIPHERALS)/src/i2c/data/i2c.hjson" \
		i2cRegsScript.sml

i2cMappingsScript.sml: ../util/gen_mappings.py ../util/common.py i2cCoreTheory.uo i2cRegsCommTheory.uo
	PYTHONPATH="$(REGISTER_INTERFACE)/vendor/lowrisc_opentitan/util:..:$PYTHONPATH" \
		python3 -m util.gen_mappings \
		"$(OPENTITAN_PERIPHERALS)/src/i2c/data/i2c.hjson" \
		i2cMappingsScript.sml

i2cRegsCommScript.sml: ../util/gen_regs_comm.py ../util/common.py \
	../common/cheshireMiscTheory.uo ../common/cheshireOracleTheory.uo \
	i2cRegsTheory.uo
	PYTHONPATH="$(REGISTER_INTERFACE)/vendor/lowrisc_opentitan/util:..:$PYTHONPATH" \
		python3 -m util.gen_regs_comm \
		"$(OPENTITAN_PERIPHERALS)/src/i2c/data/i2c.hjson" \
		i2cRegsCommScript.sml

i2cRegsCircuitLib.sml: ../util/gen_regs_circuit.py ../util/common.py
	PYTHONPATH="$(REGISTER_INTERFACE)/vendor/lowrisc_opentitan/util:..:$PYTHONPATH" \
		python3 -m util.gen_regs_circuit \
		"$(OPENTITAN_PERIPHERALS)/src/i2c/data/i2c.hjson" \
		i2cRegsCircuitLib.sml

i2c_circuit.v: i2cCircuitCompileTheory.uo
	sv2v i2c_circuit.sv --write=i2c_circuit.v

i2c.v: i2c_wrapper.sv
	sv2v \
	    $(CHESHIRE_INC) \
		$(OPENTITAN_PERIPHERALS)/src/i2c/rtl/*.sv \
		$(OPENTITAN_PERIPHERALS)/src/prim/rtl/prim_intr_hw.sv \
		$(OPENTITAN_PERIPHERALS)/src/prim/rtl/prim_fifo_sync.sv \
		$(OPENTITAN_PERIPHERALS)/src/prim/rtl/prim_util_pkg.sv \
		$(OPENTITAN_PERIPHERALS)/src/prim/rtl/prim_fifo_sync_cnt.sv \
		$(OPENTITAN_PERIPHERALS)/src/prim/prim_pulp_platform/*.sv \
		$(COMMON_CELLS)/src/sync.sv \
		$(REGISTER_INTERFACE)/vendor/lowrisc_opentitan/src/*.sv \
		i2c_wrapper.sv \
		--write=i2c.v --top=i2c_circuit

.PHONY: eqy
eqy: i2c_circuit.v i2c.v
	eqy i2c.eqy --force $(EQYFLAGS)
