[gold]
read_verilog spi_host_reg_top.v
prep -top spi_host_reg_top_wrapper

[gate]
read_verilog spi_host_circuit_eqy.v
prep -top spi_host_reg_top_wrapper

[script]
uniquify
sim -w -vcd reset.vcd -clock clk_i -resetn rst_ni -rstlen 2 -n 1

[strategy sby]
use sby
# k-induction seems to be failing to incorporate the two circuits' registers
# being equal into its inductive hypothesis.
engine abc pdr

[collect *]
# https://github.com/YosysHQ/eqy/issues/47
join reg2hw
